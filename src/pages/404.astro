---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const normalizedBase = base.endsWith("/") ? base : `${base}/`;
---
<BaseLayout title="Страница не найдена" noindex={true}>
  <script is:inline define:vars={{ base: normalizedBase }}>
    (function () {
      // Sub-path hosting (например, GitHub Pages project site) отдаёт эту 404
      // на неизвестные пути внутри base — нужно перенаправить на правильный
      // base-префиксный URL. На корневом домене (base === "/") редирект не нужен.
      if (base === "/") return;

      var p = window.location.pathname || "/";
      var q = window.location.search || "";
      var h = window.location.hash || "";
      var baseNoSlash = base.slice(0, -1);
      var knownRoots = ["/docs", "/oem", "/safety", "/platform", "/configurations", "/roadmap"];

      if (p === "/" || p === baseNoSlash) {
        window.location.replace(base + q + h);
        return;
      }

      if (!p.startsWith(base)) {
        var isKnownRootPath = knownRoots.some(function (root) {
          return p === root || p.startsWith(root + "/");
        });

        if (isKnownRootPath) {
          window.location.replace(baseNoSlash + p + q + h);
          return;
        }

        window.location.replace(base + q + h);
      }
    })();
  </script>
  <h1>Страница не найдена</h1>
  <p>Запрошенная страница недоступна.</p>
  <p>
    Если перенаправление не началось автоматически, откройте
    <a href={normalizedBase}>{normalizedBase}</a>.
  </p>
</BaseLayout>
