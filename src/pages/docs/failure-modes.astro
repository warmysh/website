const tocHeadings = getHeadings().filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<BaseLayout
  title="Отказы и реакции системы"
  description="Отказы и реакции контроллера муфельной печи PROFORGE: поведение при сбоях датчиков, силовой части и питания, блокировка нагрева и возврат в безопасное состояние."
  tocHeadings={tocHeadings}
