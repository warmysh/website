---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Content, { getHeadings } from "../../../content/docs/cloud-monitoring.md";

const tocHeadings = getHeadings().filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<BaseLayout
  title="Мониторинг печи обжига со смартфона — облако PROFORGE"
  description="Печь на экране телефона: температура и график обжига в реальном времени, история с расходом кВт·ч, уведомления email и push о завершении и авариях. Только наблюдение — управление нагревом через облако невозможно."
  tocHeadings={tocHeadings}
>
  <Content />
</BaseLayout>
