import Content, { getHeadings } from "../../../content/docs/technical-specification.md";

const tocHeadings = getHeadings().filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<BaseLayout
  title="Техническая спецификация (публичная)"
  description="Публичная техническая спецификация контроллера муфельной печи PROFORGE: подтверждённые свойства реализованной однозонной версии контроллера обжига."
  tocHeadings={tocHeadings}
>
  <Content />
</BaseLayout>
