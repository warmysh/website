---
import BaseLayout from "../layouts/BaseLayout.astro";
import Content, { getHeadings } from "../../content/contacts.md";

const tocHeadings = getHeadings().filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<BaseLayout
  title="Контакты PROFORGE"
  description="Связь с инженерной командой PROFORGE: подбор контроллера для муфельной печи, OEM-интеграция, документация и облачный мониторинг. Email, телефон и облачный сервис app.proforge.ru."
  keywords={[
    "PROFORGE контакты",
    "контроллер печи купить",
    "OEM контроллер печи связь",
    "контроллер муфельной печи производитель"
  ]}
  tocHeadings={tocHeadings}
>
  <Content />
</BaseLayout>
