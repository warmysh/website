---
import BaseLayout from "../layouts/BaseLayout.astro";
import Content, { getHeadings } from "../../content/index.md";

const tocHeadings = getHeadings().filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<BaseLayout
  title="Контроллер обжига для муфельной печи — терморегулятор PROFORGE"
  description="Программируемый терморегулятор (контроллер) для муфельных печей обжига керамики: 11 готовых программ, свои программы до 50 сегментов, защита от перегрева и обрыва термопары, продолжение обжига после сбоя питания, мониторинг печи со смартфона."
  keywords={[
    "терморегулятор для муфельной печи",
    "контроллер для муфельной печи",
    "контроллер обжига керамики",
    "программируемый терморегулятор для печи",
    "терморегулятор для печи обжига керамики",
    "программатор для муфельной печи",
    "ПИД-регулятор для муфельной печи",
    "автоматика для печи обжига",
    "блок управления муфельной печью",
    "мониторинг печи обжига со смартфона",
    "OEM контроллер печи"
  ]}
  tocHeadings={tocHeadings}
>
  <Content />
</BaseLayout>
