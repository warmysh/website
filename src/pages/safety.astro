---
import BaseLayout from "../layouts/BaseLayout.astro";
import Content, { getHeadings } from "../../content/safety.md";

const tocHeadings = getHeadings().filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<BaseLayout
  title="Защита муфельной печи от перегрева — безопасность PROFORGE"
  description="Как контроллер PROFORGE защищает печь: аварийное отключение при перегреве и обрыве термопары, двойное размыкание силовой цепи (SSR и аварийное реле), контроль тока и износа спирали, обязательный SELFTEST перед нагревом, watchdog."
  keywords={[
    "защита муфельной печи от перегрева",
    "печь пережигает что делать",
    "обрыв термопары муфельной печи",
    "защита от перегрева печи обжига",
    "безопасность контроллера печи",
    "fail-closed контроллер нагрева",
    "контроль износа спирали печи",
    "watchdog контроллер печи"
  ]}
  tocHeadings={tocHeadings}
>
  <Content />
</BaseLayout>
