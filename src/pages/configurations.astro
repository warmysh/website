---
import BaseLayout from "../layouts/BaseLayout.astro";
import Content, { getHeadings } from "../../content/configurations.md";

const tocHeadings = getHeadings().filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<BaseLayout
  title="Конфигурации контроллера муфельной печи PROFORGE"
  description="Один контроллер — разные печи: модельные конфигурации PROFORGE под мощность, пороги и программы конкретной печи. Однозонный контроллер для лабораторных муфелей и камерных печей мастерских, режимы PROGRAM и MANUAL."
  keywords={[
    "конфигурации контроллера печи",
    "однозонный контроллер печи",
    "контроллер муфельной печи",
    "терморегулятор для печи обжига",
    "автоматика для муфельной печи"
  ]}
  tocHeadings={tocHeadings}
>
  <Content />
</BaseLayout>
