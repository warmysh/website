---
import BaseLayout from "../layouts/BaseLayout.astro";
import Content, { getHeadings } from "../../content/platform.md";

const tocHeadings = getHeadings().filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<BaseLayout
  title="Платформа и архитектура контроллера печи PROFORGE"
  description="Как устроен контроллер муфельной печи PROFORGE: разделение интерфейсов, ядра управления, контура безопасности и силовой части; ПИД-регулирование, продолжение обжига после сбоя питания, изоляция сети от нагрева."
  keywords={[
    "архитектура контроллера печи",
    "система управления электропечью",
    "контроллер муфельной печи",
    "ПИД-регулятор для печи",
    "отказоустойчивый контроллер нагрева",
    "продолжение обжига после сбоя питания"
  ]}
  tocHeadings={tocHeadings}
>
  <Content />
</BaseLayout>
