---
import BaseLayout from "../layouts/BaseLayout.astro";
import Content, { getHeadings } from "../../content/roadmap.md";

const tocHeadings = getHeadings().filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<BaseLayout
  title="Статус платформы и развитие"
  description="Статус платформы PROFORGE: реализованные функции серийной прошивки и направления развития. Функции публикуются только после фактической реализации."
  keywords={[
    "roadmap контроллер печи",
    "развитие контроллера обжига",
    "контроллер муфельной печи PROFORGE"
  ]}
  tocHeadings={tocHeadings}
>
  <Content />
</BaseLayout>
