---
import BaseLayout from "../layouts/BaseLayout.astro";
import Content, { getHeadings } from "../../content/roadmap.md";

const tocHeadings = getHeadings().filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<BaseLayout
  title="Направления развития (Roadmap)"
  description="Состояние реализации и направления развития платформы контроллера печи PROFORGE. Изменения публикуются только после фактической реализации; это не план поставки и не анонс сроков."
  keywords={[
    "roadmap контроллер печи",
    "развитие контроллера обжига",
    "контроллер муфельной печи PROFORGE",
    "многозонный контроллер печи"
  ]}
  tocHeadings={tocHeadings}
>
  <Content />
</BaseLayout>
