---
const { items = [] } = Astro.props;
---
<ul class="toc-list">
  {items.map((item) => {
    const children = Array.isArray(item.children) ? item.children : [];
    return (
      <li>
        <a href={`#${item.slug}`}>{item.text}</a>
        {children.length > 0 ? <Astro.self items={children} /> : null}
      </li>
    );
  })}
</ul>
