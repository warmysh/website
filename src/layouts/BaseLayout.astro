---
import fs from "node:fs";
import NavTree from "../components/NavTree.astro";
import TocTree from "../components/TocTree.astro";
import "../styles/global.css";

const DEFAULT_DESCRIPTION =
  "PROFORGE Kiln Controller — промышленный контроллер муфельной печи для OEM-производителей электропечей: fail-closed защита нагрева, обязательный SELFTEST, ПИД-регулирование, программы обжига и облачный мониторинг.";
const DEFAULT_KEYWORDS = [
  "контроллер для печей",
  "контроллер муфельной печи",
  "контроллер обжига",
  "терморегулятор печи",
  "ПИД-регулятор печи",
  "автоматика для электропечей",
  "контроллер электропечи",
  "система управления печью",
  "контроллер обжига керамики",
  "OEM контроллер печи",
  "PROFORGE"
];

const {
  title = "PROFORGE",
  description = "",
  keywords = [],
  noindex = false,
  tocHeadings = []
} = Astro.props;

const robotsContent = noindex ? "noindex, follow" : "index, follow, max-image-preview:large";

const metaDescription = description || DEFAULT_DESCRIPTION;
const metaKeywords = (keywords.length > 0 ? keywords : DEFAULT_KEYWORDS).join(", ");
const siteOrigin = Astro.site ? Astro.site.origin : "https://oem.proforge.ru";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const ogImageUrl = new URL("/og-image.svg", siteOrigin).href;
const navFile = new URL("../../content/_nav.md", import.meta.url);
const navSource = fs.readFileSync(navFile, "utf-8");
const baseUrl = import.meta.env.BASE_URL;

function normalizePath(path) {
  if (!path) return "/";
  const prefixed = path.startsWith("/") ? path : `/${path}`;
  const collapsed = prefixed.replace(/\/{2,}/g, "/");
  return collapsed.endsWith("/") ? collapsed : `${collapsed}/`;
}

function joinWithBase(routePart = "") {
  const normalizedBase = normalizePath(baseUrl);
  const normalizedPart = routePart.replace(/^\/+/, "");
  return normalizePath(`${normalizedBase}${normalizedPart}`);
}

function markdownHrefToRoute(markdownHref) {
  const normalized = markdownHref.trim().replace(/^\.\/+/, "");
  const pageName = normalized.replace(/\.md$/i, "");
  const routePart = pageName === "index" ? "" : `${pageName}/`;
  return joinWithBase(routePart);
}

function parseNavTree(markdown) {
  const roots = [];
  const stack = [];

  markdown.split(/\r?\n/).forEach((line) => {
    const match = line.match(/^(\s*)-\s+\[([^\]]+)\]\(([^)]+)\)\s*$/);
    if (!match) return;

    const leading = match[1].replace(/\t/g, "  ");
    const depth = Math.floor(leading.length / 2);
    const node = {
      label: match[2].trim(),
      href: markdownHrefToRoute(match[3]),
      children: []
    };

    while (stack.length > 0 && stack[stack.length - 1].depth >= depth) {
      stack.pop();
    }

    if (stack.length === 0) {
      roots.push(node);
    } else {
      stack[stack.length - 1].node.children.push(node);
    }

    stack.push({ depth, node });
  });

  return roots;
}

function markNavState(items, currentPathname) {
  return items.map((item) => {
    const children = markNavState(item.children, currentPathname);
    const isSelfActive = item.href === currentPathname;
    const isBranchActive = isSelfActive || children.some((child) => child.isBranchActive);

    return {
      ...item,
      children,
      isSelfActive,
      isBranchActive
    };
  });
}

function collectNavRoutes(items, result = new Set()) {
  items.forEach((item) => {
    result.add(item.href);
    collectNavRoutes(item.children, result);
  });
  return result;
}

function buildTocTree(headings) {
  const roots = [];
  let currentH2 = null;

  headings.forEach((heading) => {
    if (!heading || !heading.slug || !heading.text) return;

    const normalizedText = heading.text.replace(/\s*#\s*$/, "").trim();
    if (!normalizedText) return;

    if (heading.depth === 2) {
      currentH2 = {
        slug: heading.slug,
        text: normalizedText,
        children: []
      };
      roots.push(currentH2);
      return;
    }

    if (heading.depth === 3) {
      const child = { slug: heading.slug, text: normalizedText };
      if (currentH2) {
        currentH2.children.push(child);
      } else {
        roots.push({ ...child, children: [] });
      }
    }
  });

  return roots;
}

const parsedNav = parseNavTree(navSource);
const currentPath = normalizePath(Astro.url.pathname);
const knownRoutes = collectNavRoutes(parsedNav);
const notFoundRoute = joinWithBase("404/");
const isKnownRoute = knownRoutes.has(currentPath) || currentPath === notFoundRoute;
const navItems = markNavState(parsedNav, currentPath);
const tocItems = buildTocTree(tocHeadings);
const hasToc = tocItems.length > 0;
const pageTitle =
  title === "PROFORGE" || /PROFORGE/i.test(title) ? title : `${title} — PROFORGE`;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteOrigin}/#organization`,
      name: "PROFORGE",
      url: `${siteOrigin}/`,
      logo: ogImageUrl,
      description:
        "Разработчик контроллеров муфельных печей для OEM-производителей электропечей: fail-closed защита нагрева, ПИД-регулирование, программы обжига и облачный мониторинг.",
      sameAs: ["https://github.com/warmysh"]
    },
    {
      "@type": "WebSite",
      "@id": `${siteOrigin}/#website`,
      url: `${siteOrigin}/`,
      name: "PROFORGE Kiln Controller",
      inLanguage: "ru-RU",
      description: DEFAULT_DESCRIPTION,
      publisher: { "@id": `${siteOrigin}/#organization` }
    }
  ]
};
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="keywords" content={metaKeywords} />
    <meta name="robots" content={robotsContent} />
    <meta name="author" content="PROFORGE" />
    <meta name="theme-color" content="#0b0f14" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PROFORGE" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/xml" href="/sitemap.xml" title="Sitemap" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <header class="site-header">
      <div class="shell shell--header">
        <a class="brand" href={normalizePath(baseUrl)}>PROFORGE</a>
        <div class="header-actions">
          <a
            class="header-btn header-btn--ghost"
            href={`${normalizePath(baseUrl)}files/OEM_Proforge_Kiln_Controller.pptx`}
            title="Скачать презентацию для OEM (PPTX)"
            aria-label="Скачать презентацию для OEM"
            download
          >Презентация</a>
          <a
            class="header-btn cloud-link"
            href="https://app.proforge.ru/login"
            rel="noopener"
            title="Вход для владельцев печей"
            aria-label="Proforge Kiln Cloud — вход для владельцев печей"
          >Proforge Kiln Cloud</a>
        </div>
      </div>
    </header>

    <div class="shell shell--layout">
      <aside class="site-aside" aria-label="Навигация">
        <details class="site-nav-mobile">
          <summary>Разделы</summary>
          <nav class="site-nav" aria-label="Навигация сайта">
            <NavTree items={navItems} />
          </nav>
        </details>

        <nav class="site-nav site-nav-desktop" aria-label="Навигация сайта">
          <NavTree items={navItems} />
        </nav>
      </aside>

      <main class="site-main">
        {hasToc ? (
          <details class="site-toc-mobile">
            <summary>Оглавление</summary>
            <nav class="site-toc-nav" aria-label="Page sections">
              <TocTree items={tocItems} />
            </nav>
          </details>
        ) : null}

        {isKnownRoute ? (
          <article class="markdown-body">
            <slot />
          </article>
        ) : (
          <article class="markdown-body markdown-body--not-found">
            <h1>Not found</h1>
            <p>Запрошенный маршрут отсутствует в подтверждённой навигации.</p>
          </article>
        )}
      </main>

      <aside class="site-toc" aria-label="Оглавление">
        {hasToc ? (
          <nav class="site-toc-nav" aria-label="Page sections">
            <h2>На странице</h2>
            <TocTree items={tocItems} />
          </nav>
        ) : null}
      </aside>
    </div>

    <footer class="site-footer">
      <div class="shell shell--footer">PROFORGE · Docs v0.1</div>
    </footer>
  </body>
</html>
