---
import fs from "node:fs";
import "../styles/global.css";

const { title = "Zhuzhimima" } = Astro.props;
const navFile = new URL("../../content/_nav.md", import.meta.url);
const navSource = fs.readFileSync(navFile, "utf-8");
const year = new Date().getFullYear();

function markdownHrefToRoute(markdownHref) {
  const normalized = markdownHref.trim().replace(/^\.\/+/, "");
  const pageName = normalized.replace(/\.md$/i, "");
  return pageName === "index" ? "/" : `/${pageName}`;
}

const navItems = navSource
  .split(/\r?\n/)
  .map((line) => {
    const match = line.match(/^- \[(.+)\]\((.+)\)$/);
    if (!match) return null;
    return {
      label: match[1],
      href: markdownHrefToRoute(match[2])
    };
  })
  .filter(Boolean);

const currentPath = Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/+$/, "");
const pageTitle = title === "Zhuzhimima" ? title : `${title} | Zhuzhimima`;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell shell--header">
        <a class="brand" href="/">Zhuzhimima</a>
      </div>
    </header>

    <div class="shell shell--layout">
      <aside class="site-aside">
        <nav class="site-nav" aria-label="Site navigation">
          <ul>
            {navItems.map((item) => (
              <li>
                <a href={item.href} class={item.href === currentPath ? "active" : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>

      <main class="site-main">
        <article class="markdown-body">
          <slot />
        </article>
      </main>
    </div>

    <footer class="site-footer">
      <div class="shell shell--footer">v0 | {year}</div>
    </footer>
  </body>
</html>
