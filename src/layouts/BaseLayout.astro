---
import fs from "node:fs";

const { title = "Zhuzhimima" } = Astro.props;
const navFile = new URL("../../content/_nav.md", import.meta.url);
const navSource = fs.readFileSync(navFile, "utf-8");

function markdownHrefToRoute(markdownHref) {
  const normalized = markdownHref.trim().replace(/^\.\/+/, "");
  const pageName = normalized.replace(/\.md$/i, "");
  return pageName === "index" ? "/" : `/${pageName}`;
}

const navItems = navSource
  .split(/\r?\n/)
  .map((line) => {
    const match = line.match(/^- \[(.+)\]\((.+)\)$/);
    if (!match) return null;
    return {
      label: match[1],
      href: markdownHrefToRoute(match[2])
    };
  })
  .filter(Boolean);

const currentPath = Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "");
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      :root {
        --bg: #fafafa;
        --surface: #ffffff;
        --text: #1f1f1f;
        --muted: #5c5c5c;
        --border: #d9d9d9;
        --accent: #1f1f1f;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: "Segoe UI", Tahoma, sans-serif;
        line-height: 1.6;
      }

      .site {
        display: grid;
        grid-template-columns: minmax(220px, 300px) minmax(0, 1fr);
        gap: 24px;
        max-width: 1120px;
        margin: 0 auto;
        padding: 24px;
      }

      aside {
        align-self: start;
        position: sticky;
        top: 16px;
      }

      nav {
        border: 1px solid var(--border);
        background: var(--surface);
        border-radius: 8px;
        padding: 14px 16px;
      }

      nav h2 {
        margin: 0 0 10px;
        font-size: 1rem;
      }

      nav ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      nav li + li {
        margin-top: 8px;
      }

      nav a {
        color: var(--muted);
        text-decoration: none;
      }

      nav a:hover,
      nav a:focus-visible {
        color: var(--text);
        text-decoration: underline;
      }

      nav a.active {
        color: var(--accent);
        font-weight: 600;
      }

      main {
        border: 1px solid var(--border);
        background: var(--surface);
        border-radius: 8px;
        padding: 28px;
        min-width: 0;
      }

      main :where(h1, h2, h3) {
        line-height: 1.3;
      }

      main h1 {
        margin-top: 0;
      }

      main :where(table) {
        width: 100%;
        border-collapse: collapse;
        overflow-x: auto;
        display: block;
      }

      main :where(th, td) {
        border: 1px solid var(--border);
        padding: 8px 10px;
        vertical-align: top;
      }

      main :where(code) {
        font-family: Consolas, "Courier New", monospace;
        font-size: 0.95em;
      }

      footer {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 24px 24px;
        color: var(--muted);
        font-size: 0.9rem;
      }

      @media (max-width: 900px) {
        .site {
          grid-template-columns: 1fr;
          padding: 16px;
        }

        aside {
          position: static;
        }

        main {
          padding: 20px;
        }
      }
    </style>
  </head>
  <body>
    <div class="site">
      <aside>
        <nav aria-label="Навигация сайта">
          <h2>Навигация</h2>
          <ul>
            {navItems.map((item) => (
              <li>
                <a href={item.href} class={item.href === currentPath ? "active" : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
      <main>
        <slot />
      </main>
    </div>
    <footer>Контент v0</footer>
  </body>
</html>
